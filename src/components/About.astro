---
import DiagramSheet from "./DiagramSheet.astro";
import NotebookPage from "./NotebookPage.astro";
import styles from "./About.module.css";
import cpuSvg from "../assets/doodles/cpu-diagram.svg?raw";
import capacitorSvg from "../assets/doodles/capacitor.svg?raw";
import transistorSvg from "../assets/doodles/transistor.svg?raw";

const workingOn = [
	"Storage engines and I/O paths. Lately, that means wiring a lock-free ring straight into io_uring.",
	"NUMA-aware queues. I trust the profiler more than the neat idea.",
	"SIMD-friendly layouts, because a cache-line invalidation does not care how clever the algorithm is.",
	"Security tools I can read all the way through, including a WAF built on Coraza and the OWASP core rule set.",
];

const howIWork = [
	"Start with a question",
	"Measure it before and after",
	"Keep the failed version in the write-up",
	"Follow whatever I cannot stop thinking about",
];

const tools = ["C++20", "Go", "CMake", "RocksDB", "io_uring", "SIMD", "lock-free", "NUMA", "LaTeX"];
---

<NotebookPage id="about">
	<p class={styles.marginNote} aria-hidden="true">page 02 / things I keep returning to</p>
	<div class="heading-row">
		<h2 class={styles.heading}>
			<span class="hl" style="--hl: var(--marker-mint-wash)">about me</span>
		</h2>
		<div class="doodle-icon" style="--doodle-w: 56px; --doodle-rot: 3deg" set:html={capacitorSvg} />
	</div>

	<div class={styles.columns}>
		<div class={`${styles.col} ${styles.working}`}>
			<h3>what I work on</h3>
			<ul>
				{workingOn.map((item) => <li>{item}</li>)}
			</ul>
		</div>
		<div class={`${styles.col} ${styles.method}`}>
			<h3>how I work</h3>
			<ul>
				{howIWork.map((item) => <li>{item}</li>)}
			</ul>
		</div>
	</div>

	<div class={styles.toolbox}>
		<div class="heading-row">
			<h3>toolbox</h3>
			<div class="doodle-icon" style="--doodle-w: 48px; --doodle-rot: -4deg" set:html={transistorSvg} />
		</div>
		<ul class={styles.badges}>
			{tools.map((tool) => <li data-sketch-badge>{tool}</li>)}
		</ul>
	</div>

	<DiagramSheet id="02" title="Under the lid" subtitle="A CPU package, then a closer look at the work inside."
    svg={cpuSvg} notes={[
      "The heat spreader sits over the silicon die; the substrate connects it to the socket.",
      "Cores keep nearby data in caches. The exact cache layout depends on the processor.",
      "Follow the arrows: instructions go through a core, data moves through the memory hierarchy."
    ]} />
</NotebookPage>
