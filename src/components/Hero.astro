---
import NotebookPage from "./NotebookPage.astro";
import styles from "./Hero.module.css";
import smSvg from "../assets/doodles/sm-core-diagram.svg?raw";
import chipSvg from "../assets/doodles/chip.svg?raw";
---

<NotebookPage id="hero" reveal={false}>
	<p class={styles.marginNote} aria-hidden="true">notes from somewhere below the abstraction layer</p>
	<div class={styles.introRow}>
		<div class={styles.copy}>
			<p class={styles.eyebrow}>independent researcher</p>
			<h1 class={styles.name}>Parth</h1>
			<p class={styles.tagline}>
				I like the parts of a system you only notice when they go wrong:
				<span class="hl" style="--hl: var(--marker-mint-wash)"
					>storage engines, lock-free queues, cache lines, and the awkward bits around I/O</span
				>.
			</p>
			<p class={styles.lede}>
				Most days are a loop of reading papers, writing C++ or Go, staring at a profiler, and
				crossing out the idea I was sure would work.
			</p>
			<div class={styles.ctaRow}>
				<button type="button" data-sketch-button="solid" onclick="document.getElementById('projects')?.scrollIntoView({behavior: 'smooth'})">
					browse the projects
				</button>
				<button type="button" data-sketch-button="outline" onclick="document.getElementById('contact')?.scrollIntoView({behavior: 'smooth'})">
					say hello
				</button>
			</div>
		</div>
		<div class={styles.chipWrap}>
			<span class={styles.tape} aria-hidden="true"></span>
			<div class={styles.chipIcon} set:html={chipSvg} />
			<p aria-hidden="true">probably a cache miss</p>
		</div>
	</div>
	<div class={styles.diagramRow}>
		<p class={styles.diagramNote} aria-hidden="true">the kind of diagram that starts simple<br />and ends with six arrows</p>
		<div class={`diagram-figure ${styles.heroDiagram}`} set:html={smSvg} />
	</div>
</NotebookPage>
