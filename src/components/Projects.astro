---
import NotebookPage from "./NotebookPage.astro";
import ProjectCard from "./ProjectCard.astro";
import styles from "./Projects.module.css";
import gpuSvg from "../assets/doodles/gpu-diagram.svg?raw";
import transistorSvg from "../assets/doodles/transistor.svg?raw";
import shieldSvg from "../assets/doodles/shield.svg?raw";
import terminalSvg from "../assets/doodles/terminal.svg?raw";
import diceSvg from "../assets/doodles/dice.svg?raw";
import bucketSvg from "../assets/doodles/bucket.svg?raw";
import ringBufferSvg from "../assets/doodles/ring-buffer.svg?raw";
import nvmeSvg from "../assets/doodles/nvme.svg?raw";
import vectorLanesSvg from "../assets/doodles/vector-lanes.svg?raw";

const projects = [
	{
		title: "coraza-waf-mod",
		summary:
			"A Coraza WAF and reverse proxy packed into one Go binary. CLI flags handle the bootstrap; the built-in dashboard keeps runtime settings in SQLite, so there is no separate config service to nurse.",
		tags: ["Go", "Coraza", "WAF"],
		href: "https://github.com/sinhaparth5/coraza-waf-mod",
		titleColor: "var(--marker-purple)",
		doodle: shieldSvg,
		doodleRot: "-2deg",
	},
	{
		title: "gittop",
		summary:
			"A terminal dashboard for git and CI, built with FTXUI and libgit2. Working tree, history, diffs, branches, stashes, and the activity graph all stay on one offline screen.",
		tags: ["C++", "Git", "TUI"],
		href: "https://github.com/sinhaparth5/gittop",
		titleColor: "var(--marker-pink)",
		doodle: terminalSvg,
		doodleRot: "2deg",
	},
	{
		title: "vphilox",
		summary:
			"A header-only counter RNG for C++20. The same seed gives the same sequence across compilers, operating systems, CPUs, and thread counts. Save the counter, move machines, and carry on where you stopped.",
		tags: ["C++20", "PRNG", "SIMD"],
		href: "https://github.com/sinhaparth5/vphilox",
		titleColor: "var(--marker-mint)",
		doi: "10.5281/zenodo.22103483",
		doodle: diceSvg,
		doodleRot: "-4deg",
	},
	{
		title: "MonoBucket",
		summary:
			"An S3-compatible object store with a C++20 server and Svelte dashboard in one process. No sidecars, no external database. It works with the AWS CLI, boto3, and rclone, while dashboard logins stay separate from S3 keys.",
		tags: ["C++20", "RocksDB", "S3"],
		href: "https://github.com/sinhaparth5/MonoBucket",
		titleColor: "var(--marker-peach)",
		doodle: bucketSvg,
		doodleRot: "3deg",
	},
	{
		title: "NumaRing",
		summary:
			"An MPMC queue with one ring per NUMA node, so every core does not fight over the same cache lines. Two measured fixes cut routing lookups 61x and median latency 202x. One promising backoff change made things worse, so I took it back out.",
		tags: ["C++", "NUMA", "lock-free"],
		href: "https://github.com/sinhaparth5/NumaRing",
		titleColor: "var(--marker-purple)",
		doi: "10.5281/zenodo.22232854",
		doodle: ringBufferSvg,
		doodleRot: "-2deg",
	},
	{
		title: "ringio",
		summary:
			"A header-only C++20 storage engine with no allocations on the hot path. It wires an MPMC ring into io_uring SQPOLL, pre-registers page-aligned buffers and file descriptors, then submits I/O with a memory write while the kernel poller is awake.",
		tags: ["C++20", "io_uring", "NVMe"],
		href: "https://github.com/sinhaparth5/ringio",
		titleColor: "var(--marker-pink)",
		doodle: nvmeSvg,
		doodleRot: "-1deg",
	},
	{
		title: "aparajita-memtable",
		summary:
			"A drop-in RocksDB memtable that replaces pointer chasing with one branchless vector compare. Fifteen order-preserving key surrogates fit in a 64-byte cache line, and RocksDB can select it by name without a patch.",
		tags: ["C++", "LSM-tree", "SIMD"],
		href: "https://github.com/sinhaparth5/aparajita-memtable",
		titleColor: "var(--marker-mint)",
		doi: "10.5281/zenodo.22180368",
		doodle: vectorLanesSvg,
		doodleRot: "2deg",
	},
];
---

<NotebookPage id="projects">
	<div class="heading-row">
		<h2 class={styles.heading}>
			<span class="hl" style="--hl: var(--marker-pink-wash)">things I've built</span>
		</h2>
		<div class="doodle-icon" style="--doodle-w: 52px; --doodle-rot: 4deg" set:html={transistorSvg} />
	</div>
		<p class={styles.intro}>These began as notes in the margin. Somewhere along the way they became repos.</p>

	<div class={styles.diagramWrap}>
		<div class="diagram-figure" set:html={gpuSvg} />
		<p aria-hidden="true">yes, I drew the arrows first</p>
	</div>

	<div class={styles.grid}>
		{projects.map((p) => <ProjectCard {...p} />)}
	</div>
</NotebookPage>
