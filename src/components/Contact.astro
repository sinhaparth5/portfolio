---
import DiagramSheet from "./DiagramSheet.astro";
import NotebookPage from "./NotebookPage.astro";
import CopyButton from "./CopyButton.astro";
import styles from "./Contact.module.css";
import waveformSvg from "../assets/doodles/waveform.svg?raw";


const email = "sinhaparth555@gmail.com";
---

<NotebookPage id="contact">
	<div class={styles.layout}>
		<div class={styles.noteCard}>
			<span class={styles.tape} aria-hidden="true"></span>
			<h2 class={styles.heading}>
				<span class="hl" style="--hl: var(--marker-peach-wash)">say hi</span>
			</h2>
			<div class={styles.wave} set:html={waveformSvg} />
			<p class={styles.note}>
				Questions, corrections, and the occasional "you got this register wrong" email are all
				welcome. I read everything, though sometimes the reply takes a minute.
			</p>

			<div class={styles.row}>
				<button type="button" data-sketch-button="solid" onclick={`window.location.href='mailto:${email}'`}>
					email me
				</button>
				<a href={`mailto:${email}`}>{email}</a>
				<CopyButton value={email} label="Copy email address" />
			</div>

			<ul class={styles.social}>
				<li><a href="https://github.com/sinhaparth5" target="_blank" rel="noopener noreferrer" data-sketch-underline>github</a></li>
				<li><a href="https://x.com/parth_sinha18" target="_blank" rel="noopener noreferrer" data-sketch-underline>x / twitter</a></li>
			</ul>
		</div>

	</div>
  <DiagramSheet id="05" title="The Wi-Fi card" subtitle="A closer look at the little board inside."
    image="/illustrations/wifi-card-labeled.webp" imageWidth={1536} imageHeight={1024}
    alt="Blue pen drawing of an internal M.2 Wi-Fi card, labeled with antenna connectors, RF shield, retaining screw, gold edge contacts, and circuit board."
    notes={[]} />
</NotebookPage>
