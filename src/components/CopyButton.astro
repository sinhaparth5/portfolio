---
interface Props {
	value: string;
	label: string;
	class?: string;
}

const { value, label, class: extraClass } = Astro.props;
---

<button type="button" class={`copy-btn ${extraClass ?? ""}`} data-copy={value} aria-label={label}>
	<svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" />
		<path d="M3.5 10.5 H2.5 A1 1 0 0 1 1.5 9.5 V2.5 A1 1 0 0 1 2.5 1.5 H9.5 A1 1 0 0 1 10.5 2.5 V3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
	</svg>
	<span class="copy-btn-text">copy</span>
</button>
