<section class="cpu-lesson" aria-labelledby="cpu-lesson-title" data-step="0">
  <header class="lesson-heading">
    <div><p class="note-index">A LITTLE EXPERIMENT / YOU'RE IN CHARGE</p><h2 id="cpu-lesson-title">How does a CPU add two numbers?</h2><p>Let's give it <strong data-sum>3 + 5</strong>. You move it through each step and watch the answer appear.</p></div>
    <span class="pencil-note" aria-hidden="true">a tiny job.<br />let's look inside ↙</span>
  </header>

  <ol class="step-track" aria-label="Calculation progress">
    {['Fetch', 'Decode', 'Calculate', 'Write back'].map((label, i) => <li data-stage={i + 1}><span>{i + 1}</span>{label}</li>)}
  </ol>

  <div class="machine" aria-label="Diagram: a task in memory moves through the CPU to an answer">
    <div class="memory diagram-part" data-part="memory">
      <span class="part-caption">MEMORY</span>
      <p class="hand-label">the to-do list</p>
      <div class="task-slip"><span>please work out</span><strong data-sum>3 + 5</strong><span class="task-state">waiting to be fetched</span></div>
      <table class="memory-map">
        <caption>address → stored number</caption>
        <tbody>
          <tr><th scope="row"><code>0x1000</code></th><td>→</td><td id="memory-a">3</td></tr>
          <tr><th scope="row"><code>0x1004</code></th><td>→</td><td id="memory-b">5</td></tr>
        </tbody>
      </table>
      <p id="memory-access" class="memory-access">two numbers, two addresses</p>
      <svg viewBox="0 0 160 30" aria-hidden="true"><path d="M8 7q70 5 145-1M12 17q65 4 132 0M18 27h122" /></svg>
    </div>

    <span class="flow-arrow arrow-in" aria-hidden="true">→</span>
    <div class="processor diagram-part" data-part="cpu">
      <svg class="chip-outline" viewBox="0 0 400 340" preserveAspectRatio="none" aria-hidden="true">
        <path class="chip-fill" d="M30 28Q190 19 369 28L373 311Q200 320 28 310Z" />
        <g>{[65,105,145,185,225,265,305,345].map(x => <path d={`M${x} 9v17M${x} 314v17`} />)}{[64,104,144,184,224,264].map(y => <path d={`M9 ${y}h20M372 ${y}h19`} />)}</g>
      </svg>
      <div class="cpu-inside">
        <div class="cpu-title"><strong>CPU</strong><span>the processor</span></div>
        <div class="control" data-part="control"><span>CONTROL UNIT</span><strong id="cpu-instruction">waiting for a job</strong><small>reads what to do</small></div>
        <div class="registers" data-part="registers"><span>REGISTERS <small>tiny holding spaces</small></span><div><div class="register-slot"><b id="register-a">?</b><small>from <code>0x1000</code></small></div><i>+</i><div class="register-slot"><b id="register-b">?</b><small>from <code>0x1004</code></small></div></div></div>
        <div class="inside-arrow" aria-hidden="true">↓</div>
        <div class="alu" data-part="alu"><span>ALU <small>the arithmetic part</small></span><strong id="alu-result">ready to add</strong></div>
      </div>
    </div>
    <span class="flow-arrow arrow-out" aria-hidden="true">→</span>

    <div class="answer diagram-part" data-part="answer"><span class="part-caption">RESULT</span><p class="hand-label">back in memory</p><div class="answer-paper"><span class="result-address">store at <code>0x1008</code></span><span>the answer is…</span><output id="cpu-answer" aria-label="Calculated answer">?</output><span id="answer-caption">let's find out</span></div><span class="answer-star" aria-hidden="true">✧</span></div>
  </div>

  <div class="lesson-bottom">
    <div class="explanation" aria-live="polite" aria-atomic="true"><span id="step-count">READY WHEN YOU ARE</span><h3 id="step-heading">A CPU follows instructions.</h3><p id="step-explanation">Our instruction is simple: add 3 and 5. Click below to fetch the job from memory.</p></div>
    <div class="lesson-actions"><button type="button" id="cpu-next">Fetch the job →</button><button type="button" id="cpu-reset" hidden>start over ↺</button></div>
  </div>
  <p class="pointer-note"><span aria-hidden="true">↳</span> <strong>A pointer holds a memory address.</strong> <span id="pointer-explanation">The address 0x1000 points to the box holding 3.</span></p>
  <p class="lesson-footnote">Illustrative addresses for three 32-bit numbers, four bytes apart. This is a simplified simulation, not your device's actual memory.</p>
  <noscript><p>For 3 + 5: fetch the instruction, decode it as addition, calculate 8, then write the result back to memory.</p></noscript>
</section>

<script>
 const lesson = document.querySelector<HTMLElement>('.cpu-lesson')!;
 const next = document.querySelector<HTMLButtonElement>('#cpu-next')!;
 const reset = document.querySelector<HTMLButtonElement>('#cpu-reset')!;
 const examples = [[3,5], [7,4], [6,6], [9,2]];
 let example = 0;
 let step = 0;
 let traveling: HTMLElement | null = null;
 let flight: Animation | null = null;
 const write = (id: string, value: string) => { document.getElementById(id)!.textContent = value; };
 function render() {
   flight?.cancel();
   traveling?.remove();
   const [a,b] = examples[example];
   const sum = a+b;
   lesson.dataset.step = String(step);
   lesson.querySelectorAll('[data-sum]').forEach(el => {el.textContent = `${a} + ${b}`;});
   lesson.querySelectorAll<HTMLElement>('[data-stage]').forEach(el => {
     const current = Number(el.dataset.stage) === step;
     el.classList.toggle('done', Number(el.dataset.stage) < step);
     if(current) el.setAttribute('aria-current','step'); else el.removeAttribute('aria-current');
   });
   const active = [['memory'], ['memory','control'], ['control','registers'], ['registers','alu'], ['answer']][step];
   lesson.querySelectorAll<HTMLElement>('[data-part]').forEach(el => el.classList.toggle('active', active.includes(el.dataset.part!)));
   write('cpu-instruction', step === 0 ? 'waiting for a job' : step === 1 ? `received: ${a} + ${b}` : 'instruction: ADD');
   write('memory-a', String(a));
   write('memory-b', String(b));
   write('memory-access', step === 2 ? 'read these → into registers' : 'two numbers, two addresses');
   write('pointer-explanation', step === 4 ? `The answer ${sum} is now stored at 0x1008. The original numbers stay at 0x1000 and 0x1004.` : `The address 0x1000 points to the box holding ${a}. The value is ${a}; its address is 0x1000.`);
   write('register-a', step >= 2 ? String(a) : '?');
   write('register-b', step >= 2 ? String(b) : '?');
   write('alu-result', step >= 3 ? `${a} + ${b} = ${sum}` : 'ready to add');
   write('cpu-answer', step === 4 ? String(sum) : '?');
   write('answer-caption', step === 4 ? `${a} + ${b} = ${sum}. Done!` : "let's find out");
   lesson.querySelector('.task-state')!.textContent = step === 0 ? 'waiting to be fetched' : step === 4 ? 'job complete ✓' : 'the CPU has the job';
   const headings = ['A CPU follows instructions.', '1. Fetch: pick up the job.', '2. Decode: what are we doing?', '3. Calculate: do the addition.', '4. Write back: keep the answer.'];
   const explanations = [
     `Our instruction is simple: add ${a} and ${b}. Click below to fetch the job from memory.`,
     `The CPU reads the job from memory. It has received ${a} + ${b}, but hasn't calculated the answer yet.`,
     `The control unit reads this as ADD. In this simplified step, the CPU reads ${a} from address 0x1000 and ${b} from 0x1004 into its registers.`,
     `The arithmetic logic unit (ALU) adds the two numbers. ${a} + ${b} = ${sum}. The answer is ready inside the CPU.`,
     `The CPU writes ${sum} to address 0x1008. The original numbers stay at 0x1000 and 0x1004, and the program can read the answer from its new address.`
   ];
   write('step-heading', headings[step]);
   write('step-explanation', explanations[step]);
   write('step-count', step ? `STEP ${step} OF 4${step === 4 ? ' / COMPLETE' : ''}` : 'READY WHEN YOU ARE');
   next.textContent = ['Fetch the job →','Decode the instruction →','Add the numbers →','Write back the answer →','Try another sum ↺'][step];
   reset.hidden = step === 0;
   if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
     lesson.querySelectorAll('.diagram-part.active, .control.active, .registers.active, .alu.active').forEach(el => el.animate([{transform:'translateY(5px)',opacity:.6},{transform:'translateY(0)',opacity:1}],{duration:300,easing:'ease-out'}));
     if(step > 0) {
       const routes = [['.task-slip','.control'], ['.memory-map','.registers'], ['.registers','.alu'], ['.alu','.answer-paper']];
       const [from,to] = routes[step-1].map(selector => lesson.querySelector(selector)!.getBoundingClientRect());
       const token = document.createElement('span');
       token.setAttribute('aria-hidden','true');
       token.textContent = step === 4 ? String(sum) : `${a} + ${b}`;
       token.style.cssText = 'position:fixed;left:0;top:0;z-index:25;pointer-events:none;background:#fff0a7;color:#244bb0;border:2px solid #244bb0;border-radius:8px;padding:5px 12px;font:700 22px var(--font-display);';
       document.body.append(token);
       traveling = token;
       flight = token.animate([
         {transform:`translate(${from.x+from.width/2-30}px,${from.y+from.height/2-18}px) rotate(-6deg)`,opacity:1},
         {transform:`translate(${to.x+to.width/2-30}px,${to.y+to.height/2-18}px) rotate(3deg)`,opacity:0}
       ],{duration:450,easing:'ease-in-out'});
       flight.finished.then(() => token.remove()).catch(() => token.remove());
     }

   }
 }
 next.addEventListener('click', () => {if(step === 4){example=(example+1)%examples.length;step=0;}else step++;render();});
 reset.addEventListener('click', () => {step=0;render();next.focus();});
 render();
</script>

<style>
.cpu-lesson { max-width: 1000px; margin: 1rem auto 3rem; padding: 1.5rem; border-block: 1px dashed #abb9d3; }
.lesson-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
.note-index, .part-caption, #step-count { font: .65rem var(--font-mono); letter-spacing: .08em; color: var(--blue); }
.note-index { color: var(--coral); }
h2 { font-size: clamp(2rem, 4vw, 3rem); color: var(--blue); }
.lesson-heading p { font-size: 1.15rem; }
.pencil-note { flex: none; font: 1.5rem/1.1 var(--font-display); color: var(--coral); transform: rotate(6deg); }
.step-track { display: flex; flex-wrap: wrap; gap: .8rem 1.5rem; list-style: none; margin: 1.5rem 0; padding: 0; }
.step-track li { display: flex; align-items: center; gap: .4rem; color: var(--ink-soft); font-size: 1rem; }
.step-track li span { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid #afb7c8; border-radius: 48% 52% 44% 56%; font-family: var(--font-display); }
.step-track [aria-current] { color: var(--blue); }
.step-track [aria-current] span { background: #fff0a7; border-color: var(--blue); }
.step-track .done span { background: #e3f0e7; }
.machine { display: grid; grid-template-columns: minmax(0, 1fr) 32px minmax(0, 2fr) 32px minmax(0, 1fr); align-items: center; gap: .4rem; padding: .5rem 0 1.3rem; }
.diagram-part { min-width: 0; }
.hand-label { font: 1.5rem var(--font-display); margin: .2rem 0 .8rem; color: var(--blue); }
.task-slip, .answer-paper { padding: 1rem .6rem; border: 2px solid #a6b3cf; border-radius: 5px 2px 6px 3px; background: white; text-align: center; transform: rotate(-3deg); }
.task-slip span, .answer-paper span { display: block; font-size: 1rem; }
.task-slip strong { display: block; font: 700 3rem var(--font-display); color: var(--blue); margin: .5rem 0; }
.task-state { color: var(--ink-soft); }
.memory svg { width: 100%; height: 30px; fill: none; stroke: #a6b3cf; stroke-width: 1.5; }
.flow-arrow { font: 2.6rem var(--font-display); color: #a6b3cf; text-align: center; }
.processor { position: relative; padding: 2.1rem 2rem; }
.chip-outline { position: absolute; inset: 0; width: 100%; height: 100%; stroke: var(--blue); stroke-width: 2.2; fill: none; pointer-events: none; }
.chip-fill { fill: #f7f9ff; }
.cpu-inside { position: relative; }
.cpu-title { display: flex; align-items: baseline; gap: .7rem; color: var(--blue); margin-bottom: .5rem; }
.cpu-title strong { font: 700 2rem var(--font-display); }
.cpu-title span { font-size: 1rem; }
.control, .registers, .alu { border: 1px solid #b7c3dc; border-radius: 4px; background: white; padding: .5rem .65rem; }
.control > span, .registers > span, .alu > span { display: block; font: .65rem var(--font-mono); color: var(--blue); }
.control strong { display: block; font-size: 1.1rem; font-weight: 400; }
.control small, .registers small, .alu small { font: .95rem var(--font-body); color: var(--ink-soft); }
.control small { display: block; }
.registers { margin-top: .5rem; }
.registers > div { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: .3rem; }
.registers b { display: grid; place-items: center; width: 42px; height: 38px; border: 1px dashed #8b9dbf; font: 1.6rem var(--font-display); }
.registers i { font-style: normal; }
.inside-arrow { text-align: center; color: var(--blue); line-height: 1.1; }
.alu strong { display: block; text-align: center; font: 700 1.7rem var(--font-display); color: var(--blue); }
.answer { position: relative; }
.answer-paper { transform: rotate(3deg); }
#cpu-answer { display: block; font: 700 4rem/1.2 var(--font-display); color: #7c879e; margin: .5rem 0; }
.answer-star { position: absolute; top: 20px; right: -5px; font-size: 3rem; color: var(--coral); opacity: 0; }
.active .task-slip, .control.active, .registers.active, .alu.active, .active .answer-paper { border-color: var(--blue); background: #fff7d0; }
.cpu-lesson[data-step="4"] #cpu-answer { color: var(--marker-mint); }
.cpu-lesson[data-step="4"] .answer-star { opacity: 1; }
.cpu-lesson[data-step="1"] .arrow-in, .cpu-lesson[data-step="4"] .arrow-out { color: var(--blue); }
.lesson-bottom { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem; align-items: center; border-top: 1px dashed #bbc6d9; padding-top: 1.2rem; }
.explanation { min-height: 155px; }
.explanation h3 { font: 700 1.7rem var(--font-display); margin: .4rem 0; color: var(--blue); }
.explanation p { font-size: 1.1rem; margin: 0; }
.lesson-actions { display: flex; flex-direction: column; align-items: stretch; gap: .5rem; min-width: 220px; }
button { min-height: 44px; font: 1.15rem var(--font-body); padding: .6rem .9rem; border: 2px solid var(--blue); border-radius: 4px 7px 3px 5px; cursor: pointer; background: var(--blue); color: white; transition: transform .2s; }
button:hover { transform: rotate(-1deg); }
#cpu-reset { background: transparent; border-color: transparent; color: var(--ink-soft); }
button[hidden] { display: none; }
.lesson-footnote { color: var(--ink-faint); font-size: .9rem; margin: .8rem 0 0; }
@media (max-width: 700px) {
  .cpu-lesson { padding: 1rem; }
  .pencil-note { display: none; }
  .machine { grid-template-columns: minmax(0, 1fr); max-width: 390px; margin: auto; gap: .5rem; }
  .memory, .answer { width: 85%; margin: auto; }
  .task-slip { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .3rem 1rem; padding: .5rem; }
  .task-slip strong { font-size: 2rem; margin: 0; }
  .task-state { width: 100%; }
  .memory svg { display: none; }
  .hand-label { margin-bottom: .3rem; }
  .flow-arrow { transform: rotate(90deg); line-height: .8; }
  .processor { padding: 2rem; }
  .answer-paper { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .3rem 1rem; padding: .5rem; }
  #cpu-answer { font-size: 2.7rem; margin: 0; }
  #answer-caption { width: 100%; }
  .lesson-bottom { display: contents; }
  .explanation { min-height: 0; }
  .lesson-actions { min-width: 0; position: sticky; bottom: .5rem; z-index: 10; background: white; padding: .5rem; border: 1px solid #d8dfed; border-radius: 6px; margin-top: .7rem; }
  .step-track { gap: .5rem 1rem; }
}

.memory-map { width: 100%; margin-top: .9rem; border-collapse: collapse; font-size: 1.05rem; }
.memory-map caption { text-align: left; font: 1.2rem var(--font-display); color: var(--blue); margin-bottom: .3rem; }
.memory-map th, .memory-map td { border-bottom: 1px dashed #bdc7db; padding: .35rem .2rem; text-align: left; font-weight: 400; }
.memory-map td:last-child { text-align: center; font: 700 1.4rem var(--font-display); }
.memory-map code, .result-address code { font: .8rem var(--font-mono); color: var(--blue); }
.memory-access { font-size: .95rem; line-height: 1.25; margin: .4rem 0 0; color: var(--ink-soft); }
.register-slot { display: flex; flex-direction: column; align-items: center; gap: .3rem; min-width: 0; }
.register-slot small { font-size: .75rem; text-align: center; }
.register-slot code { font: .65rem var(--font-mono); display: block; }
.result-address { border-bottom: 1px dashed #b5c1d8; padding-bottom: .4rem; margin-bottom: .5rem; width: 100%; }
.cpu-lesson[data-step="2"] .memory-map tr { background: #fff0a7; }
.cpu-lesson[data-step="2"] .memory-access { color: var(--blue); }
.cpu-lesson[data-step="4"] .result-address { background: #e3f0e7; }
.pointer-note { max-width: none; background: #f5f7fc; padding: .7rem 1rem; margin: .8rem 0; border-left: 2px solid #a6b3cf; font-size: 1rem; }
.pointer-note > span:first-child { color: var(--blue); margin-right: .4rem; }
</style>
