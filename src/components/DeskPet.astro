---
// Mochi cat: each mood/action is its own pre-drawn frame (src/assets/mochi-cat),
// pre-rendered here and toggled by pet.ts rather than swapping one shared SVG's
// sub-parts — simpler once there are this many distinct poses.
import idleSvg from "../assets/mochi-cat/idle.svg?raw";
import blinkSvg from "../assets/mochi-cat/blink.svg?raw";
import walk1Svg from "../assets/mochi-cat/walk-1.svg?raw";
import walk2Svg from "../assets/mochi-cat/walk-2.svg?raw";
import run1Svg from "../assets/mochi-cat/run-1.svg?raw";
import run2Svg from "../assets/mochi-cat/run-2.svg?raw";
import eatSvg from "../assets/mochi-cat/eat.svg?raw";
import sleepSvg from "../assets/mochi-cat/sleep.svg?raw";
import angrySvg from "../assets/mochi-cat/angry.svg?raw";
import happySvg from "../assets/mochi-cat/happy.svg?raw";
import loveSvg from "../assets/mochi-cat/love.svg?raw";
import surprisedSvg from "../assets/mochi-cat/surprised.svg?raw";
import sadSvg from "../assets/mochi-cat/sad.svg?raw";
import playSvg from "../assets/mochi-cat/play.svg?raw";
import stretchSvg from "../assets/mochi-cat/stretch.svg?raw";

const poses: Record<string, string> = {
	idle: idleSvg,
	blink: blinkSvg,
	"walk-1": walk1Svg,
	"walk-2": walk2Svg,
	"run-1": run1Svg,
	"run-2": run2Svg,
	eat: eatSvg,
	sleep: sleepSvg,
	angry: angrySvg,
	happy: happySvg,
	love: loveSvg,
	surprised: surprisedSvg,
	sad: sadSvg,
	play: playSvg,
	stretch: stretchSvg,
};
---

<button id="desk-pet" class="pet" type="button" data-pose="idle" aria-label="Pet Mochi Mochi the cat" title="Pet Mochi · double-click to play">
	<span class="pet-bubble" aria-hidden="true"></span>
	{
		Object.entries(poses).map(([name, svg]) => (
			<span class="pet-pose" data-pose-frame={name} hidden={name !== "idle"} set:html={svg} />
		))
	}
</button>
<script src="../scripts/pet.ts"></script>

<style>
	.pet {
		position: fixed;
		top: 0;
		left: 0;
		width: 84px;
		height: 84px;
		z-index: 30;
		cursor: pointer;
		user-select: none;
		padding: 0;
		border: 0;
		background: transparent;
		touch-action: manipulation;
		border-radius: 40%;
	}

	.pet-pose {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}

	/* Every pose shares the same canvas and baseline. */
	.pet-pose :global(svg) {
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		display: block;
		transform: scaleX(var(--pet-facing, 1));
	}

	.pet-pose[hidden] {
		display: none;
	}

	.pet-bubble {
		position: absolute;
		top: -1.7rem;
		left: 50%;
		transform: translateX(-50%);
		background: var(--paper);
		border: 1px solid var(--ink-faint);
		border-radius: 999px;
		padding: 0.15rem 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}

	.pet-bubble.show {
		opacity: 1;
	}


  .pet-pose { transform-origin: 50% 90%; }
  @media (prefers-reduced-motion: no-preference) {
    .pet[data-pose="idle"] .pet-pose:not([hidden]),
    .pet[data-pose="sleep"] .pet-pose:not([hidden]) { animation: mochi-breathe 2.6s ease-in-out infinite; }
    .pet[data-pose="happy"] .pet-pose:not([hidden]),
    .pet[data-pose="love"] .pet-pose:not([hidden]) { animation: mochi-bounce .55s ease-in-out infinite; }
    .pet[data-pose="eat"] .pet-pose:not([hidden]) { animation: mochi-nibble .3s ease-in-out infinite; }
    .pet[data-pose="play"] .pet-pose:not([hidden]) { animation: mochi-wiggle .45s ease-in-out infinite; }
    .pet[data-pose="angry"] .pet-pose:not([hidden]) { animation: mochi-wiggle .15s ease-in-out 4; }
    .pet[data-pose="stretch"] .pet-pose:not([hidden]) { animation: mochi-stretch .9s ease-in-out; }
    .pet[data-pose="surprised"] .pet-pose:not([hidden]) { animation: mochi-startle .35s ease-out; }
    .pet :global(.mochi-hearts), .pet :global(.mochi-zzz) { animation: mochi-float 1.4s ease-in-out infinite; }
    .pet :global(.mochi-ball) { animation: mochi-ball .6s ease-in-out infinite alternate; }
  }
  @keyframes mochi-breathe { 50% { transform: scale(1.025, .975); } }
  @keyframes mochi-bounce { 50% { transform: translateY(-4px) scale(.98, 1.03); } }
  @keyframes mochi-nibble { 50% { transform: translateY(1px) scale(1.025, .98); } }
  @keyframes mochi-wiggle { 25% { transform: rotate(-4deg); } 75% { transform: rotate(4deg); } }
  @keyframes mochi-stretch { 50% { transform: scale(1.12, .86); } }
  @keyframes mochi-startle { 45% { transform: translateY(-7px) scale(.94, 1.08); } }
  @keyframes mochi-float { 50% { transform: translateY(-3px); opacity: .6; } }
  @keyframes mochi-ball { to { transform: translateX(7px); } }

	@media (max-width: 640px) {
		.pet {
			width: 64px;
			height: 64px;
		}
	}
</style>
