---
import NotebookPage from "./NotebookPage.astro";
import CopyButton from "./CopyButton.astro";
import styles from "./Papers.module.css";
import paperSvg from "../assets/doodles/paper-stack.svg?raw";
import diceSvg from "../assets/doodles/dice.svg?raw";
import ringBufferSvg from "../assets/doodles/ring-buffer.svg?raw";
import nvmeSvg from "../assets/doodles/nvme.svg?raw";
import vectorLanesSvg from "../assets/doodles/vector-lanes.svg?raw";

const papers = [
	{
		title: "vphilox",
		tagline:
			"The sequence is the contract. This paper explains the counter-state format and how one seed stays reproducible across compilers, operating systems, CPUs, and thread counts.",
		href: "https://github.com/sinhaparth5/vphilox/blob/master/paper/vphilox.pdf",
		doi: "10.5281/zenodo.22103483",
		doodle: diceSvg,
		doodleRot: "-4deg",
	},
	{
		title: "NumaRing",
		tagline:
			"Why one shared MPMC queue starts to hurt as core counts climb, and what changed when each NUMA node got its own ring. The write-up includes the 61x routing and 202x median-latency gains, plus the backoff idea the benchmarks rejected.",
		href: "https://github.com/sinhaparth5/NumaRing/blob/master/paper/main.pdf",
		doi: "10.5281/zenodo.22232854",
		doodle: ringBufferSvg,
		doodleRot: "-2deg",
	},
	{
		title: "ringio",
		tagline:
			"A walk through the ring buffer, SQPOLL submission path, registered buffers, and fixed file descriptors. It also covers the tail-latency problem that only appeared on a wider multi-socket machine.",
		href: "https://github.com/sinhaparth5/ringio/blob/master/docs/paper/ringio-paper.pdf",
		doodle: nvmeSvg,
		doodleRot: "-1deg",
	},
	{
		title: "aparajita-memtable",
		tagline:
			"RocksDB's skip list scatters comparisons across the heap. This paper puts fifteen key surrogates in one cache line, searches them with a branchless SIMD compare, and measures the result in invalidations and branch misses.",
		href: "https://github.com/sinhaparth5/aparajita-memtable/blob/master/paper/main.pdf",
		doi: "10.5281/zenodo.22180368",
		doodle: vectorLanesSvg,
		doodleRot: "2deg",
	},
];
---

<NotebookPage id="papers">
	<p class={styles.marginNote} aria-hidden="true">longer notes, fewer crossed-out bits</p>
	<div class="heading-row">
		<h2 class={styles.heading}>
			<span class="hl" style="--hl: var(--marker-mint-wash)">write-ups</span>
		</h2>
		<div class="doodle-icon" style="--doodle-w: 52px; --doodle-rot: 2deg" set:html={paperSvg} />
	</div>
	<p class={styles.intro}>Some projects left enough questions behind that I wrote the long version.</p>

	<ul class={styles.list}>
		{
			papers.map((p) => (
				<li class={styles.item}>
					<span class={styles.paperclip} aria-hidden="true"></span>
					<div class={styles.body}>
						<h3>{p.title}</h3>
						<p>{p.tagline}</p>
						<div class={styles.meta}>
							<a href={p.href} target="_blank" rel="noopener noreferrer" data-sketch-underline>
								read the paper →
							</a>
							{p.doi && (
								<>
									<a class={styles.doi} href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer">
										doi:{p.doi}
									</a>
									<CopyButton value={p.doi} label={`Copy DOI for ${p.title}`} />
								</>
							)}
						</div>
					</div>
					<div class={styles.doodle} style={`--doodle-rot: ${p.doodleRot}`} set:html={p.doodle} />
				</li>
			))
		}
	</ul>
</NotebookPage>
