---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Papers from "../components/Papers.astro";
import Contact from "../components/Contact.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import BackToTop from "../components/BackToTop.astro";
import DeskPet from "../components/DeskPet.astro";
import NotebookClutter from "../components/NotebookClutter.astro";
---

<Layout
	title="Parth Sinha | Independent Systems Researcher"
	description="Independent systems research on C++ storage engines, lock-free queues, io_uring, NUMA, and SIMD. Explore Parth Sinha's projects, benchmarks, and papers."
>
	<div class="notebook">
		<NotebookClutter />
		<Nav />
		<main id="main-content" tabindex="-1">
			<Hero />
			<hr class="divider dividerOne" data-sketch-divider />
			<About />
			<hr class="divider dividerTwo" data-sketch-divider />
			<Projects />
			<hr class="divider dividerThree" data-sketch-divider />
			<Papers />
			<hr class="divider dividerFour" data-sketch-divider />
			<Contact />
		</main>
	</div>
	<ConsentBanner />
	<BackToTop />
	<DeskPet />
	<script src="../scripts/drawably-init.ts"></script>
	<script src="../scripts/scroll-effects.ts"></script>
	<script src="../scripts/copy.ts"></script>
</Layout>

<style>
	.notebook {
		position: relative;
		width: 100%;
		margin: 0;
		background: var(--paper);
		isolation: isolate;
	}

	.notebook::before {
		display: none;
	}

	main {
		position: relative;
		z-index: 1;
		padding: var(--space-4) 1.25rem var(--space-5);
	}

	.divider {
		width: min(72%, 42rem);
		margin: 1.25rem auto;
		color: var(--ink-faint);
		border: 0;
	}

	.dividerOne,
	.dividerThree {
		transform: rotate(-0.6deg) translateX(-3%);
	}

	.dividerTwo,
	.dividerFour {
		transform: rotate(0.75deg) translateX(4%);
	}

	@media (max-width: 640px) {
		.notebook {
			width: 100%;
			margin: 0;
		}

		.notebook::before {
			display: none;
		}

		main {
			padding: var(--space-3) 0.5rem var(--space-4);
		}
	}
</style>
